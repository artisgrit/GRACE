# GRACE Environment Variables
# Copy this file to .env and update values for your deployment

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_PASSWORD=grace_secure_password_change_me_in_production

# ===========================================
# OpenSearch Configuration
# ===========================================
OPENSEARCH_PASSWORD=admin_secure_password_change_me_in_production

# ===========================================
# MinIO Object Storage Configuration
# ===========================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_password_change_me_in_production

# ===========================================
# Keycloak Configuration
# ===========================================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_password_change_me_in_production

# ===========================================
# JWT Secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
# ===========================================
JWT_SECRET=change_this_to_a_secure_random_string_minimum_32_characters
JWT_ISSUER=grace
JWT_ACCESS_TOKEN_MINUTES=30

# Initial local administrator. Remove these after the account has been created.
GRACE_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
GRACE_BOOTSTRAP_ADMIN_PASSWORD=replace_with_at_least_12_random_characters
GRACE_BOOTSTRAP_ADMIN_NAME=GRACE Administrator

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=grace
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=grace-frontend
BACKEND_API_URL=http://backend:8080/api/v1
GRACE_TENANT_SLUG=default
COOKIE_SECURE=false

# ===========================================
# Backend Configuration
# ===========================================
SPRING_PROFILES_ACTIVE=docker
GRACE_PUBLIC_BASE_URL=http://localhost:8080
GRACE_MCP_AUDIENCE=grace-mcp
GRACE_MCP_AUTHORIZATION_SERVER=http://localhost:8180/realms/grace
GRACE_MCP_ALLOWED_ORIGINS=http://localhost:3000

# ===========================================
# AI Configuration (Optional)
# ===========================================
# Configure provider details per tenant in /admin/ai.
# Store API credentials only in environment variables, then enter that variable name in GRACE.
# GRACE_AI_API_KEY=replace_with_provider_secret

# ===========================================
# Analytics Configuration (Optional)
# ===========================================
# MATOMO_URL=https://analytics.your institution.edu
# MATOMO_SITE_ID=1
