# Use unique values from a secrets manager. Do not commit the populated file.
POSTGRES_PASSWORD=replace-with-32-or-more-random-characters
REDIS_PASSWORD=replace-with-32-or-more-random-characters
OPENSEARCH_PASSWORD=replace-with-32-or-more-random-characters
MINIO_ROOT_USER=grace-storage-admin
MINIO_ROOT_PASSWORD=replace-with-32-or-more-random-characters
KEYCLOAK_ADMIN=grace-identity-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-32-or-more-random-characters
KEYCLOAK_HOSTNAME=identity.example.edu
JWT_SECRET=replace-with-at-least-32-random-bytes

GRACE_PUBLIC_BASE_URL=https://grace.example.edu
GRACE_CORS_ALLOWED_ORIGINS=https://grace.example.edu
GRACE_MCP_AUTHORIZATION_SERVER=https://identity.example.edu/realms/grace
GRACE_BOOTSTRAP_ADMIN_EMAIL=
GRACE_BOOTSTRAP_ADMIN_PASSWORD=
GRACE_BOOTSTRAP_ADMIN_NAME=GRACE Administrator

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_KEYCLOAK_URL=https://identity.example.edu
NEXT_PUBLIC_KEYCLOAK_REALM=grace
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=grace-frontend
GRACE_TENANT_SLUG=default
COOKIE_SECURE=true

GRACE_RATE_LIMIT_ENABLED=true
GRACE_RATE_LIMIT_LOGIN_PER_MINUTE=10
GRACE_RATE_LIMIT_MCP_PER_MINUTE=120
GRACE_RATE_LIMIT_PUBLIC_PER_MINUTE=240
